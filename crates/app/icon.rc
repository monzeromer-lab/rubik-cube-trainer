// Windows resource script. The IDI_ICON1 entry is what File Explorer,
// the taskbar, and the Alt-Tab switcher pick up as the application
// icon. The VERSIONINFO block populates the .exe's "Details" tab
// (Properties → Details) with author, copyright, and version data.
// `windres` (mingw) and `rc.exe` (MSVC) both accept this dialect.

IDI_ICON1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION    0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS         0x40004L
FILETYPE       0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Monzer Omer"
            VALUE "FileDescription",  "Rubik's Trainer"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "rubiks-trainer"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Monzer Omer"
            VALUE "OriginalFilename", "rubiks-trainer.exe"
            VALUE "ProductName",      "Rubik's Trainer"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
